    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
